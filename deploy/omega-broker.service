[Unit]
Description=MatVerse Omega privileged broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omega
Group=omega
UMask=0077
WorkingDirectory=/var/lib/omega-broker
EnvironmentFile=/etc/omega-broker/environment
ExecStart=/usr/local/bin/omega-broker --config /etc/omega-broker/policy.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/omega-broker /run/omega-broker
ReadOnlyPaths=/etc/omega-broker

[Install]
WantedBy=multi-user.target
